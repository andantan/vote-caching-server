# Server name
SERVER_NAME=verivote-caching-server

# gRPC Event Listener Configuration
GRPC_EVENT_LISTENER_PORT=50051

# MongoDB Configuration
# Hosts are Docker Compose service names. Use 127.0.0.1 when running outside Docker.
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=voting_db
MONGODB_USER_COLLECTION=users
MONGODB_VOTE_COLLECTION=votes
